# Copie este arquivo para .env antes de iniciar o Docker Compose.
POSTGRES_PASSWORD=defina-uma-senha-local
RABBITMQ_PASSWORD=defina-outra-senha-local

# Valores opcionais. Os valores abaixo ja sao os padroes do projeto.
POSTGRES_DB=biblioteca_facil
POSTGRES_USER=biblioteca
CONFIG_SERVER_PORT=8888
CONSULTA_ISBN_PORT=8081
BIBLIOTECA_API_PORT=8080
NOTIFICACAO_SERVICE_PORT=8082
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=biblioteca

# Integracoes HTTP: timeouts em milissegundos e retries totais de chamadas GET.
CONSULTA_ISBN_CONNECT_TIMEOUT=3000
CONSULTA_ISBN_READ_TIMEOUT=5000
CONSULTA_ISBN_MAX_TENTATIVAS=3
CONSULTA_ISBN_INTERVALO_RETRY_MS=250
BRASIL_API_URL=https://brasilapi.com.br
BRASIL_API_CONNECT_TIMEOUT=3000
BRASIL_API_READ_TIMEOUT=5000
BRASIL_API_MAX_TENTATIVAS=3
BRASIL_API_INTERVALO_RETRY_MS=250

# Mensageria de reservas e importacao em chunks.
RESERVAS_EXCHANGE=biblioteca.reservas
RESERVA_SOLICITADA_QUEUE=biblioteca.reserva-solicitada
RESERVA_SOLICITADA_ROUTING_KEY=reserva.solicitada
IMPORTACAO_LIVROS_CHUNK=10
