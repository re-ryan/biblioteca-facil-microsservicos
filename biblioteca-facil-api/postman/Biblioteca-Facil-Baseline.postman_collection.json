  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const statusEsperado = Number(pm.info.requestName.match(/\\((\\d{3})\\)$/)?.[1]);",
          "if (statusEsperado) {",
          "  pm.test('Status ' + statusEsperado, () => pm.response.to.have.status(statusEsperado));",
          "}"
        ]
      }
    }
