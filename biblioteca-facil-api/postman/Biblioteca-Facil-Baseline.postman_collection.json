            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Conceição Evaristo\",\n  \"nomeCatalogacao\": \"EVARISTO, Conceição\"\n}"
            },
            "url": "{{baseUrl}}/api/autores"
