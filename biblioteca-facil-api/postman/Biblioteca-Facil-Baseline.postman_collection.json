    {
      "name": "Reservas",
      "item": [
        {
          "name": "Identificar leitor e bibliotecário (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const usuarios = pm.response.json();",
                  "const leitor = usuarios.find(usuario => usuario.tipoUsuario === 'LEITOR');",
                  "const bibliotecario = usuarios.find(usuario => usuario.tipoUsuario === 'BIBLIOTECARIO');",
                  "pm.expect(leitor).to.exist;",
                  "pm.expect(bibliotecario).to.exist;",
                  "pm.collectionVariables.set('leitorId', leitor.id);",
                  "pm.collectionVariables.set('bibliotecarioId', bibliotecario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Identificar acervo (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bibliotecas = pm.response.json();",
                  "const biblioteca = bibliotecas.find(item => item.acervos?.length > 0);",
                  "pm.expect(biblioteca).to.exist;",
                  "pm.collectionVariables.set('acervoId', biblioteca.acervos[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bibliotecas"
          }
        },
